module pukan.vulkan.shaders;

package mixin template Shaders()
{
    import pukan.exceptions: PukanVulkanException;
    import std.conv: to;
    import std.exception: enforce;

    /// Identity of an uploaded shader module: binary content and stage
    private struct ShaderKey
    {
        const(ubyte)[] binary;
        VkShaderStageFlagBits stage;

        size_t toHash() const nothrow @safe
        {
            // Arrays hash by content; the stage is mixed in as the seed.
            // The default struct hash uses raw bytes, including slice pointers.
            return hashOf(binary, hashOf(stage));
        }

        bool opEquals(ref const ShaderKey rhs) const nothrow @safe
        {
            return binary == rhs.binary && stage == rhs.stage;
        }
    }

    private ShaderInfo[ShaderKey] loadedShaders;

    ShaderInfo uploadShaderToGPU(
        ubyte[] sprivBinary,
        VkShaderStageFlagBits stage,
        VkDescriptorSetLayoutBinding[] layoutBindings,
        VkPushConstantRange pushConstant = VkPushConstantRange.init,
        ShaderVertexInput vertexInput = ShaderVertexInput.init,
    )
    // import("...spv") data is generated by our build, so a bad size is a contract violation
    in(sprivBinary.length % 4 == 0)
    in(stage == VK_SHADER_STAGE_VERTEX_BIT ||
        (vertexInput.bindings.length == 0 && vertexInput.attributes.length == 0))
    {
        const key = ShaderKey(sprivBinary, stage);

        if(auto found = key in loadedShaders)
        {
            enforce!PukanVulkanException(found.layoutBindings == layoutBindings,
                "shader " ~ stage.to!string ~
                " is uploaded with different descriptor set layout bindings");
            enforce!PukanVulkanException(found.pushConstantRange == pushConstant,
                "shader " ~ stage.to!string ~
                " is uploaded with different push constant ranges");
            enforce!PukanVulkanException(found.vertexInput == vertexInput,
                "shader " ~ stage.to!string ~
                " is uploaded with a different vertex input");

            return *found;
        }

        VkShaderModuleCreateInfo cinf = {
            sType: VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
            codeSize: sprivBinary.length,
            pCode: cast(uint*) sprivBinary.ptr,
        };

        ShaderInfo add;
        vkCreateShaderModule(device, &cinf, this.alloc, &add.shaderModule).vkCheck;
        add.stage = stage;
        add.layoutBindings = layoutBindings;
        add.pushConstantRange = pushConstant;
        add.vertexInput = vertexInput;

        loadedShaders[key] = add;

        return add;
    }

    //TODO: remove?
    auto uploadShaderFromFileToGPU(
        string filename,
        VkShaderStageFlagBits stage,
        VkDescriptorSetLayoutBinding[] layoutBindings,
        VkPushConstantRange pushConstant = VkPushConstantRange.init,
        ShaderVertexInput vertexInput = ShaderVertexInput.init,
    )
    {
        import std.file: read;

        auto code = cast(ubyte[]) read(filename);

        enforce!PukanVulkanException(code.length % 4 == 0, "SPIR-V code size must be a multiple of 4");

        return uploadShaderToGPU(code, stage, layoutBindings, pushConstant, vertexInput);
    }

    private void shadersDtor()
    {
        foreach(info; loadedShaders)
            vkDestroyShaderModule(this.device, info.shaderModule, this.alloc);
    }
}

import pukan.vulkan.bindings;

//TODO: move to C header and use from GLSL code too
/// Vertex input consumed by a vertex shader
struct ShaderVertexInput
{
    VkVertexInputBindingDescription[] bindings;
    VkVertexInputAttributeDescription[] attributes;
}

struct ShaderInfo
{
    VkShaderModule shaderModule;
    VkShaderStageFlagBits stage;
    VkDescriptorSetLayoutBinding[] layoutBindings;
    VkPushConstantRange pushConstantRange;
    ShaderVertexInput vertexInput;

    auto createShaderStageInfo()
    {
        VkPipelineShaderStageCreateInfo cinf = {
            sType: VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
            stage: stage,
            pName: "main", // shader entry point
        };

        // "module" is D keyword, workaround:
        __traits(getMember, cinf, "module") = shaderModule;

        return cinf;
    }
}

VkDescriptorSetLayoutBinding[] createLayoutBinding(ShaderInfo[] shaders)
{
    VkDescriptorSetLayoutBinding[] ret;

    foreach(ref shader; shaders)
        foreach(ref binding; shader.layoutBindings)
        {
            assert(binding.stageFlags == shader.stage);

            bool merged;
            foreach(ref existing; ret)
                if(existing.binding == binding.binding)
                {
                    assert(existing.descriptorType == binding.descriptorType);
                    assert(existing.descriptorCount == binding.descriptorCount);
                    assert(existing.pImmutableSamplers is binding.pImmutableSamplers);

                    existing.stageFlags |= binding.stageFlags;
                    merged = true;
                    break;
                }

            if(!merged)
                ret ~= binding;
        }

    return ret;
}
