#version 460

// Turns a frame's multisampled depth into the coarse grid the CPU tests against.
// The image cannot be copied - a copy wants one sample and a resolve takes colour
// only - so it is sampled here, four samples per texel, nearest of the block.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2DMS depthImage;
layout(set = 0, binding = 1) writeonly buffer Depths
{
    float nearest[];
};

layout(set = 0, binding = 2, r32f) writeonly uniform image2D nearestImage;

layout(push_constant) uniform Push
{
    uint gridWidth;
    uint gridHeight;
    uint texOffsetX;
    uint texOffsetY;
    uint texWidth;
    uint texHeight;
    uint samples;
} pc;

void main()
{
    const uvec2 cell = gl_GlobalInvocationID.xy;

    if(cell.x >= pc.gridWidth || cell.y >= pc.gridHeight)
        return;

    const uint blockWidth = pc.texWidth / pc.gridWidth;
    const uint blockHeight = pc.texHeight / pc.gridHeight;

    // The scene compares depth with GREATER, so the largest value is the nearest
    float depth = 0.0;

    for(uint y = 0; y < blockHeight; ++y)
        for(uint x = 0; x < blockWidth; ++x)
        {
            const ivec2 p = ivec2(
                pc.texOffsetX + cell.x * blockWidth + x,
                pc.texOffsetY + cell.y * blockHeight + y
            );

            for(uint s = 0; s < pc.samples; ++s)
                depth = max(depth, texelFetch(depthImage, p, int(s)).r);
        }

    nearest[cell.y * pc.gridWidth + cell.x] = depth;
    imageStore(nearestImage, ivec2(cell), vec4(depth, 0.0, 0.0, 1.0));
}
