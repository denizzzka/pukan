#version 460

layout(local_size_x = 64) in;

layout(push_constant) uniform Push {
    uint cylinderCount;
} pc;

layout(std430, binding = 0) readonly buffer SourceA { vec4 sourceA[]; };
layout(std430, binding = 1) readonly buffer SourceB { vec4 sourceB[]; };
layout(std430, binding = 2) readonly buffer Buckets { int buckets[]; };
layout(std430, binding = 3) readonly buffer Offsets { uint offsets[]; };
layout(std430, binding = 4) buffer Cursors { uint cursors[]; };
layout(std430, binding = 5) writeonly buffer Instances { vec4 instances[]; };

void main()
{
    const uint tid = gl_GlobalInvocationID.x;
    if(tid >= pc.cylinderCount)
        return;

    const int bucket = buckets[tid];
    if(bucket < 0)
        return;

    const vec4 a = sourceA[tid];
    const vec4 b = sourceB[tid];
    const vec3 p0 = a.xyz;
    const vec3 p1 = b.xyz;
    const float radius = a.w;
    const float group = b.w;

    const vec3 axisVector = p1 - p0;
    const float axisLength = length(axisVector);
    const vec3 axis = axisLength > 1e-6 ? axisVector / axisLength : vec3(0.0, 1.0, 0.0);

    const vec3 reference = abs(axis.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    const vec3 u = normalize(cross(reference, axis));
    const vec3 v = cross(axis, u);

    const uint slot = atomicAdd(cursors[bucket], 1u);
    const uint dst = offsets[bucket] + slot;

    instances[dst * 4u + 0u] = vec4(p0, group);
    instances[dst * 4u + 1u] = vec4(axisVector, 0.0);
    instances[dst * 4u + 2u] = vec4(u * radius, 0.0);
    instances[dst * 4u + 3u] = vec4(v * radius, 0.0);
}
