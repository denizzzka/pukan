#version 460

layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer Counts { uint counts[]; };
layout(std430, binding = 1) buffer Offsets { uint offsets[]; };
layout(std430, binding = 2) buffer Cursors { uint cursors[]; };
layout(std430, binding = 3) buffer Commands { uint commands[]; };

void main()
{
    uint running = 0u;

    for(uint bucket = 0u; bucket < 64u; ++bucket)
    {
        const uint count = counts[bucket];
        offsets[bucket] = running;
        cursors[bucket] = 0u;
        commands[bucket * 5u + 1u] = count;
        commands[bucket * 5u + 4u] = running;
        running += count;
    }
}
