name "vulkan"
description "Vulkan API D library"
authors "Denis Feklushkin"
copyright "Copyright © 2025, Denis Feklushkin"
license "BSL-1.0"
importPaths "source" "../source/pukan/shaders"
stringImportPaths "../compiled_shaders"
dependency "misc:lockfree" version="~>0.0.5"
dependency "mir-ion" version="~>2.3.3"
dependency "dlib" version="~>1.4.0-beta1"
dflags "-preview=in"
libs "vulkan" platform="posix"
libs `$VULKAN_SDK\Lib\vulkan-1` platform="windows"
cImportPaths "$VULKAN_SDK\\Include" platform="windows"
