name "pukan"
description "Vulkan API D library"
authors "Denis Feklushkin"
copyright "Copyright © 2025, Denis Feklushkin"
license "BSL-1.0"
stringImportPaths "compiled_shaders"
importPaths "source" "source/pukan/shaders"
dependency ":vulkan" version="*"
dependency "dlib" version="~>1.4.0-beta1"
dependency "gamut" version="~>3.3.2"
dependency "vibe-serialization" version="~>1.1.3"
dflags "-preview=in"
#"-preview=dip1021" #disabled due to incompatibility with mir-ion json serializer
libs "webp" platform="posix"
libs "zstd" platform="posix"

subPackage "vulkan"
subPackage "demo"
subPackage "demo_compute"
subPackage "demo_godot"
